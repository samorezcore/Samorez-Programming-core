package org.firstinspires.ftc.teamcode;

import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorEx;
import com.qualcomm.robotcore.hardware.DcMotorSimple;
import com.qualcomm.robotcore.hardware.Servo;

import org.firstinspires.ftc.robotcore.external.navigation.DistanceUnit;

import com.qualcomm.hardware.gobilda.GoBildaPinpointDriver;
import com.pedropathing.follower.Follower;
import com.pedropathing.follower.FollowerConstants;
import com.pedropathing.ftc.FollowerBuilder;
import com.pedropathing.ftc.drivetrains.MecanumConstants;
import com.pedropathing.ftc.localization.constants.PinpointConstants;
import com.pedropathing.geometry.Pose;

@TeleOp(name = "SAFE_FieldCentric_Turret")
public class drive extends LinearOpMode {

    // PID
    public static double kP = 0.012;
    public static double kD = 0.0025;
    public static double kStatic = 0.03;
    public static double deadzone = 2.0;  // degrees
    public static double MAX_POWER = 0.6;

    // Turret mechanical limit
    public static double TURRET_MIN_LIMIT = -160.0;
    public static double TURRET_MAX_LIMIT = 160.0;

    // Normal tracking max power vs snap power
    public static double TRACKING_MAX_POWER = 0.25;
    public static double SNAP_POWER = 0.8;

    private static final double TICKS_PER_DEGREE = 238.0 / 360.0;

    // Target position for turret to look at
    private static final double TARGET_X = 7.0;
    private static final double TARGET_Y = 142.0;

    // Hardware
    private DcMotor frontLeft, frontRight, backLeft, backRight;
    private DcMotorEx turret, shooterMaster, shooterFollower;
    private DcMotor intake;
    private Servo armServo, hoodServo;

    private Follower follower;

    // Pedro Pathing Constants
    public static FollowerConstants followerConstants = new FollowerConstants();

    public static MecanumConstants driveConstants = new MecanumConstants()
            .leftFrontMotorName("EH_motor1")
            .leftRearMotorName("EH_motor2")
            .rightFrontMotorName("CH_motor3")
            .rightRearMotorName("CH_motor2")
            .leftFrontMotorDirection(DcMotorSimple.Direction.REVERSE)
            .leftRearMotorDirection(DcMotorSimple.Direction.REVERSE)
            .rightFrontMotorDirection(DcMotorSimple.Direction.FORWARD)
            .rightRearMotorDirection(DcMotorSimple.Direction.FORWARD);

    public static PinpointConstants localizerConstants = new PinpointConstants()
            .hardwareMapName("pinpoint")
            .distanceUnit(DistanceUnit.INCH)
            .forwardPodY(-5)
            .strafePodX(1)
            .encoderResolution(GoBildaPinpointDriver.GoBildaOdometryPods.goBILDA_4_BAR_POD)
            .forwardEncoderDirection(GoBildaPinpointDriver.EncoderDirection.REVERSED)
            .strafeEncoderDirection(GoBildaPinpointDriver.EncoderDirection.REVERSED);

    class PID {
        double lastError = 0;

        double wrap(double a) {
            a = a % 360;
            if (a > 180) a -= 360;
            if (a < -180) a += 360;
            return a;
        }

        double update(double error) {
            error = wrap(error);
            double derivative = error - lastError;
            lastError = error;

            double output = error * kP + derivative * kD;

            // Add static friction compensation
            if (output > 0) output += kStatic;
            else if (output < 0) output -= kStatic;

            // Clamp
            return Math.max(-TRACKING_MAX_POWER, Math.min(TRACKING_MAX_POWER, output));
        }
    }

    private final PID turretPID = new PID();

    private double wrapAngle(double a) {
        a = a % 360;
        if (a > 180) a -= 360;
        if (a < -180) a += 360;
        return a;
    }

    @Override
    public void runOpMode() {
        // Hardware Map
        frontLeft = hardwareMap.dcMotor.get("EH_motor1");
        frontRight = hardwareMap.dcMotor.get("CH_motor3");
        backLeft = hardwareMap.dcMotor.get("EH_motor2");
        backRight = hardwareMap.dcMotor.get("CH_motor2");

        turret = hardwareMap.get(DcMotorEx.class, "EH_motor0");
        shooterMaster = hardwareMap.get(DcMotorEx.class, "CH_motor1");
        shooterFollower = hardwareMap.get(DcMotorEx.class, "CH_motor0");
        intake = hardwareMap.dcMotor.get("EH_motor3");

        armServo = hardwareMap.servo.get("CH_servo0");
        hoodServo = hardwareMap.servo.get("CH_servo1");

        // FOLLOWER
        follower = new FollowerBuilder(followerConstants, hardwareMap)
                .mecanumDrivetrain(driveConstants)
                .pinpointLocalizer(localizerConstants)
                .build();

        follower.setStartingPose(new Pose(64, 6, Math.toRadians(0)));

        // Direcții
        frontLeft.setDirection(DcMotor.Direction.REVERSE);
        backLeft.setDirection(DcMotor.Direction.REVERSE);
        shooterMaster.setDirection(DcMotorSimple.Direction.REVERSE);
        shooterFollower.setDirection(DcMotorSimple.Direction.REVERSE);
        intake.setDirection(DcMotorSimple.Direction.REVERSE);

        turret.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        turret.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        turret.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);

        armServo.setPosition(0.35);
        hoodServo.setPosition(0.0);

        waitForStart();

        while (opModeIsActive()) {
            follower.update();

            Pose pose = follower.getPose();
            double x = pose.getX();
            double y = pose.getY();
            double headingDeg = Math.toDegrees(pose.getHeading());

            // Drive
            double forward = -gamepad1.left_stick_y;
            double strafe = gamepad1.left_stick_x;
            double rotate = gamepad1.right_stick_x;

            double denom = Math.max(Math.abs(forward) + Math.abs(strafe) + Math.abs(rotate), 1);

            frontLeft.setPower((forward + strafe + rotate) / denom);
            frontRight.setPower((forward - strafe - rotate) / denom);
            backLeft.setPower((forward - strafe + rotate) / denom);
            backRight.setPower((forward + strafe - rotate) / denom);

            // ========== TURRET TRACKING ==========
            
            // 1. Calculate field-space target angle
            double dx = TARGET_X - x;
            double dy = TARGET_Y - y;
            double fieldTargetAngle = Math.toDegrees(Math.atan2(dy, dx));

            // 2. Get turret position in turret-relative degrees
            int ticks = turret.getCurrentPosition();
            double turretRelDeg = ticks / TICKS_PER_DEGREE;

            // 3. Calculate where the turret is pointing in field space
            //    worldTurret = robot heading + turret offset
            double worldTurret = wrapAngle(headingDeg + turretRelDeg);

            // 4. Calculate error in field space
            double fieldError = wrapAngle(fieldTargetAngle - worldTurret);

            // 5. Convert field error to turret-relative target
            //    The turret needs to turn by fieldError to align with target
            double turretTargetRel = wrapAngle(turretRelDeg + fieldError);

            // 6. Check limits — if target is outside, wrap around by 360
            boolean needsSnap = false;
            double finalTurretTarget = turretTargetRel;

            if (turretTargetRel > TURRET_MAX_LIMIT) {
                // Would hit max limit, wrap to other side
                finalTurretTarget = turretTargetRel - 360.0;
                needsSnap = true;
            } else if (turretTargetRel < TURRET_MIN_LIMIT) {
                // Would hit min limit, wrap to other side
                finalTurretTarget = turretTargetRel + 360.0;
                needsSnap = true;
            }

            // 7. Calculate motor error
            double motorError = finalTurretTarget - turretRelDeg;

            // 8. Choose power mode
            double power;
            if (needsSnap && Math.abs(motorError) > 45.0) {
                // Fast snap to other side
                power = (motorError > 0) ? SNAP_POWER : -SNAP_POWER;
            } else {
                // Normal PID tracking
                power = turretPID.update(motorError);

                // Deadzone — only apply when actually close
                if (Math.abs(motorError) < deadzone) {
                    power = 0;
                }
            }

            turret.setPower(power);

            // Altele
            shooterMaster.setPower(1.0);
            shooterFollower.setPower(1.0);
            intake.setPower(gamepad1.right_trigger > 0.1 ? 1.0 : 0.0);

            armServo.setPosition(gamepad1.left_trigger > 0.1 ? 0.23 : 0.35);

            if (gamepad1.a) hoodServo.setPosition(0.25);
            if (gamepad1.b) hoodServo.setPosition(0.0);

            telemetry.addData("X", x);
            telemetry.addData("Y", y);
            telemetry.addData("Heading", headingDeg);
            telemetry.addData("Field Target", fieldTargetAngle);
            telemetry.addData("World Turret", worldTurret);
            telemetry.addData("Turret Rel", turretRelDeg);
            telemetry.addData("Turret Target", finalTurretTarget);
            telemetry.addData("Motor Error", motorError);
            telemetry.addData("Needs Snap", needsSnap);
            telemetry.addData("Turret Power", power);
            telemetry.update();
        }
    }
}
