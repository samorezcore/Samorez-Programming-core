package org.firstinspires.ftc.teamcode;

import com.bylazar.configurables.annotations.Configurable;
import com.qualcomm.hardware.limelightvision.LLResult;
import com.qualcomm.hardware.limelightvision.LLResultTypes;
import com.qualcomm.hardware.limelightvision.LLStatus;
import com.qualcomm.hardware.limelightvision.Limelight3A;
import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorEx;
import com.qualcomm.robotcore.hardware.DcMotorSimple;
import com.qualcomm.robotcore.hardware.Servo;

import org.firstinspires.ftc.robotcore.external.navigation.DistanceUnit;

import com.qualcomm.hardware.gobilda.GoBildaPinpointDriver;
import com.pedropathing.follower.Follower;
import com.pedropathing.follower.FollowerConstants;
import com.pedropathing.ftc.FollowerBuilder;
import com.pedropathing.ftc.drivetrains.MecanumConstants;
import com.pedropathing.ftc.localization.constants.PinpointConstants;
import com.pedropathing.geometry.Pose;

@TeleOp(name = "SAFE_FieldCentric_Turret_Limelight_v3")
@Configurable
public class drive extends LinearOpMode {

    public static final class HardwareNames {
        public static final String FRONT_LEFT  = "EH_motor1";
        public static final String BACK_LEFT   = "EH_motor2";
        public static final String FRONT_RIGHT = "CH_motor3";
        public static final String BACK_RIGHT  = "CH_motor2";
        public static final String TURRET           = "EH_motor0";
        public static final String SHOOTER_MASTER   = "CH_motor1";
        public static final String SHOOTER_FOLLOWER = "CH_motor0";
        public static final String INTAKE           = "EH_motor3";
        public static final String ARM_SERVO  = "CH_servo0";
        public static final String HOOD_SERVO = "CH_servo1";
        public static final String PINPOINT   = "pinpoint";
        public static final String LIMELIGHT  = "limelight";
    }

    public static final class DriveConfig {
        public static final DcMotorSimple.Direction LEFT_FRONT_DIR  = DcMotorSimple.Direction.REVERSE;
        public static final DcMotorSimple.Direction LEFT_REAR_DIR   = DcMotorSimple.Direction.REVERSE;
        public static final DcMotorSimple.Direction RIGHT_FRONT_DIR = DcMotorSimple.Direction.FORWARD;
        public static final DcMotorSimple.Direction RIGHT_REAR_DIR  = DcMotorSimple.Direction.FORWARD;
    }

    public static final class TurretMechanical {
        public static final double TICKS_PER_DEGREE = 9.9166;
        public static final double MIN_ANGLE = -40;
        public static final double MAX_ANGLE = 100;
        public static final double SNAP_THRESHOLD_DEG = 5;
    }

    public static double TURRET_kP = 0.03;
    public static double TURRET_kD = 0;
    public static double TURRET_kStatic = 0;
    public static double TURRET_MAX_POWER = 0.5;
    public static double TURRET_DEADZONE_DEG = 2.0;

    public static double VISION_kP = 0.03;
    public static double VISION_kD = 0;
    public static double VISION_kStatic = 0;
    public static double VISION_MAX_POWER = 0.5;
    public static double VISION_DEADZONE_TX = 1.0;

    public static double TARGET_X = 7.0;
    public static double TARGET_Y = 142.0;

    public static int VISION_PIPELINE = 2;
    public static int VISION_TAG_ID = 20;
    public static double VISION_TRUST_FACTOR = 0.85;

    public static double SNAP_POWER = 0.8;

    public static final class ServoPositions {
        public static final double ARM_UP   = 0.37;
        public static final double ARM_DOWN = 0.23;
        public static final double HOOD_SHOOT = 0.3;
        public static final double HOOD_IDLE  = 0.0;
    }

    public static final Pose START_POSE = new Pose(64, 6, Math.toRadians(90));

    public static FollowerConstants followerConstants = new FollowerConstants();

    public static MecanumConstants driveConstants = new MecanumConstants()
            .leftFrontMotorName(HardwareNames.FRONT_LEFT)
            .leftRearMotorName(HardwareNames.BACK_LEFT)
            .rightFrontMotorName(HardwareNames.FRONT_RIGHT)
            .rightRearMotorName(HardwareNames.BACK_RIGHT)
            .leftFrontMotorDirection(DriveConfig.LEFT_FRONT_DIR)
            .leftRearMotorDirection(DriveConfig.LEFT_REAR_DIR)
            .rightFrontMotorDirection(DriveConfig.RIGHT_FRONT_DIR)
            .rightRearMotorDirection(DriveConfig.RIGHT_REAR_DIR);

    public static PinpointConstants localizerConstants = new PinpointConstants()
            .hardwareMapName(HardwareNames.PINPOINT)
            .distanceUnit(DistanceUnit.INCH)
            .forwardPodY(-5)
            .strafePodX(1)
            .encoderResolution(GoBildaPinpointDriver.GoBildaOdometryPods.goBILDA_4_BAR_POD)
            .forwardEncoderDirection(GoBildaPinpointDriver.EncoderDirection.REVERSED)
            .strafeEncoderDirection(GoBildaPinpointDriver.EncoderDirection.REVERSED);

    private DcMotorEx frontLeft, frontRight, backLeft, backRight;
    private DcMotorEx turret, shooterMaster, shooterFollower;
    private DcMotorEx intake;
    private Servo armServo, hoodServo;
    private Follower follower;
    private Limelight3A limelight;

    private double turretTargetFieldAngle = 0.0;
    private boolean visionLocked = false;
    private double lastVisionTx = 0.0;
    private int wrongTagFrames = 0;

    private static class PIDController {
        private double lastError = 0;

        double update(double error, double kP, double kD, double kStatic, double maxOutput, double deadzone) {
            if (Math.abs(error) < deadzone) {
                lastError = error;
                return 0;
            }
            double derivative = error - lastError;
            lastError = error;
            double output = error * kP + derivative * kD;
            if (output > 0) output += kStatic;
            else if (output < 0) output -= kStatic;
            return Math.max(-maxOutput, Math.min(maxOutput, output));
        }

        void reset() {
            lastError = 0;
        }
    }

    private final PIDController turretPID = new PIDController();
    private final PIDController visionPID = new PIDController();

    private double wrapAngle(double angle) {
        angle %= 360.0;
        if (angle > 180.0) angle -= 360.0;
        else if (angle < -180.0) angle += 360.0;
        return angle;
    }

    private double angleDifference(double target, double current) {
        return wrapAngle(target - current);
    }

    private void initHardware() {
        frontLeft  = hardwareMap.get(DcMotorEx.class, HardwareNames.FRONT_LEFT);
        backLeft   = hardwareMap.get(DcMotorEx.class, HardwareNames.BACK_LEFT);
        frontRight = hardwareMap.get(DcMotorEx.class, HardwareNames.FRONT_RIGHT);
        backRight  = hardwareMap.get(DcMotorEx.class, HardwareNames.BACK_RIGHT);
        turret          = hardwareMap.get(DcMotorEx.class, HardwareNames.TURRET);
        shooterMaster   = hardwareMap.get(DcMotorEx.class, HardwareNames.SHOOTER_MASTER);
        shooterFollower = hardwareMap.get(DcMotorEx.class, HardwareNames.SHOOTER_FOLLOWER);
        intake          = hardwareMap.get(DcMotorEx.class, HardwareNames.INTAKE);
        armServo  = hardwareMap.servo.get(HardwareNames.ARM_SERVO);
        hoodServo = hardwareMap.servo.get(HardwareNames.HOOD_SERVO);
        frontLeft.setDirection(DriveConfig.LEFT_FRONT_DIR);
        backLeft.setDirection(DriveConfig.LEFT_REAR_DIR);
        frontRight.setDirection(DriveConfig.RIGHT_FRONT_DIR);
        backRight.setDirection(DriveConfig.RIGHT_REAR_DIR);
        shooterMaster.setDirection(DcMotorSimple.Direction.REVERSE);
        shooterFollower.setDirection(DcMotorSimple.Direction.REVERSE);
        intake.setDirection(DcMotorSimple.Direction.REVERSE);
        turret.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        turret.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        turret.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        armServo.setPosition(ServoPositions.ARM_UP);
        hoodServo.setPosition(ServoPositions.HOOD_IDLE);
    }

    private void initLimelight() {
        limelight = hardwareMap.get(Limelight3A.class, HardwareNames.LIMELIGHT);
        limelight.setPollRateHz(100);
        limelight.pipelineSwitch(VISION_PIPELINE);
        limelight.start();
    }

    private void initFollower() {
        follower = new FollowerBuilder(followerConstants, hardwareMap)
                .mecanumDrivetrain(driveConstants)
                .pinpointLocalizer(localizerConstants)
                .build();
        follower.setStartingPose(START_POSE);
        Pose start = follower.getPose();
        double dx = TARGET_X - start.getX();
        double dy = TARGET_Y - start.getY();
        turretTargetFieldAngle = Math.toDegrees(Math.atan2(dy, dx));
    }

    private void updateDrive() {
        double forward = -gamepad1.left_stick_y;
        double strafe  = gamepad1.left_stick_x;
        double rotate  = gamepad1.right_stick_x;
        double denominator = Math.max(Math.abs(forward) + Math.abs(strafe) + Math.abs(rotate), 1.0);
        frontLeft.setPower((forward + strafe + rotate) / denominator);
        frontRight.setPower((forward - strafe - rotate) / denominator);
        backLeft.setPower((forward - strafe + rotate) / denominator);
        backRight.setPower((forward + strafe - rotate) / denominator);
    }

    private boolean updateVision(double robotHeadingDeg, double turretRelDeg) {
        LLResult result = limelight.getLatestResult();
        visionLocked = false;

        if (result == null || !result.isValid()) {
            wrongTagFrames = 0;
            return false;
        }

        if (result.getPipelineIndex() != VISION_PIPELINE) {
            limelight.pipelineSwitch(VISION_PIPELINE);
            wrongTagFrames = 0;
            return false;
        }

        java.util.List<LLResultTypes.FiducialResult> fiducials = result.getFiducialResults();
        if (fiducials == null || fiducials.isEmpty()) {
            wrongTagFrames = 0;
            return false;
        }

        LLResultTypes.FiducialResult targetFiducial = null;

        for (LLResultTypes.FiducialResult fiducial : fiducials) {
            int id = fiducial.getFiducialId();
            if (id == VISION_TAG_ID) {
                targetFiducial = fiducial;
                wrongTagFrames = 0;
                break;
            } else {
                wrongTagFrames++;
                telemetry.addData("WRONG TAG REJECTED", id);
            }
        }

        if (targetFiducial == null) {
            visionLocked = false;
            return false;
        }

        double tx = targetFiducial.getTargetXDegrees();
        lastVisionTx = tx;

        double currentWorldAngle = wrapAngle(robotHeadingDeg + turretRelDeg);
        double visionTargetAngle = wrapAngle(currentWorldAngle + tx);

        double trust = VISION_TRUST_FACTOR;
        if (Math.abs(tx) < 3.0) {
            trust = 1.0;
        }

        double angleDiff = angleDifference(visionTargetAngle, turretTargetFieldAngle);
        turretTargetFieldAngle = wrapAngle(turretTargetFieldAngle + angleDiff * trust);

        visionLocked = true;
        return true;
    }

    private void updateOdometryTarget(double robotX, double robotY) {
        double dx = TARGET_X - robotX;
        double dy = TARGET_Y - robotY;
        double odometryTarget = Math.toDegrees(Math.atan2(dy, dx));

        if (!visionLocked) {
            turretTargetFieldAngle = odometryTarget;
        }
    }

    private void updateTurret() {
        Pose pose = follower.getPose();
        double robotX = pose.getX();
        double robotY = pose.getY();
        double robotHeadingDeg = Math.toDegrees(pose.getHeading());

        double turretRelDeg = turret.getCurrentPosition() / TurretMechanical.TICKS_PER_DEGREE;

        boolean sawTag = updateVision(robotHeadingDeg, turretRelDeg);
        updateOdometryTarget(robotX, robotY);

        double targetTurretRel = angleDifference(turretTargetFieldAngle, robotHeadingDeg);

        double finalTarget;
        boolean needsSnap = false;

        if (targetTurretRel > TurretMechanical.MAX_ANGLE) {
            finalTarget = targetTurretRel - 360.0;
            needsSnap = true;
        } else if (targetTurretRel < TurretMechanical.MIN_ANGLE) {
            finalTarget = targetTurretRel + 360.0;
            needsSnap = true;
        } else {
            finalTarget = targetTurretRel;
        }

        double motorError = angleDifference(finalTarget, turretRelDeg);
        double power;

        if (needsSnap && Math.abs(motorError) > TurretMechanical.SNAP_THRESHOLD_DEG) {
            power = Math.signum(motorError) * SNAP_POWER;
        } else {
            power = turretPID.update(
                    motorError,
                    TURRET_kP, TURRET_kD, TURRET_kStatic,
                    TURRET_MAX_POWER, TURRET_DEADZONE_DEG
            );
        }

        if (visionLocked && Math.abs(lastVisionTx) > VISION_DEADZONE_TX) {
            double visionCorrection = visionPID.update(
                    lastVisionTx,
                    VISION_kP, VISION_kD, VISION_kStatic,
                    VISION_MAX_POWER, VISION_DEADZONE_TX
            );
            power += visionCorrection * 0.3;
            power = Math.max(-TURRET_MAX_POWER, Math.min(TURRET_MAX_POWER, power));
        }

        turret.setPower(power);

        telemetry.addData("=== TURRET ===", "");
        telemetry.addData("Vision Locked", visionLocked);
        telemetry.addData("Vision tx", visionLocked ? lastVisionTx : "N/A");
        telemetry.addData("Wrong Tag Frames", wrongTagFrames);
        telemetry.addData("Target Field Angle", turretTargetFieldAngle);
        telemetry.addData("Robot Heading", robotHeadingDeg);
        telemetry.addData("Turret Rel", turretRelDeg);
        telemetry.addData("Target Turret Rel", targetTurretRel);
        telemetry.addData("Final Target", finalTarget);
        telemetry.addData("Motor Error", motorError);
        telemetry.addData("Needs Snap", needsSnap);
        telemetry.addData("Turret Power", power);
        telemetry.addData("Robot X", robotX);
        telemetry.addData("Robot Y", robotY);
    }

    private void updateMechanisms() {
        shooterMaster.setPower(1.0);
        shooterFollower.setPower(1.0);
        intake.setPower(gamepad1.right_trigger > 0.1 ? 1.0 : 0.0);
        armServo.setPosition(gamepad1.left_trigger > 0.1
                ? ServoPositions.ARM_DOWN
                : ServoPositions.ARM_UP);
        if (gamepad1.a) hoodServo.setPosition(ServoPositions.HOOD_SHOOT);
        if (gamepad1.b) hoodServo.setPosition(ServoPositions.HOOD_IDLE);
    }

    private void updateLimelightTelemetry() {
        LLStatus status = limelight.getStatus();
        telemetry.addData("=== LIMELIGHT ===", "");
        telemetry.addData("Pipeline", status.getPipelineIndex());
        telemetry.addData("FPS", status.getFps());
        telemetry.addData("CPU Temp", status.getTemp());
    }

    @Override
    public void runOpMode() {
        initHardware();
        initLimelight();
        initFollower();

        waitForStart();

        while (opModeIsActive()) {
            follower.update();
            updateDrive();
            updateTurret();
            updateMechanisms();
            updateLimelightTelemetry();
            telemetry.update();
        }

        limelight.stop();
    }
}
