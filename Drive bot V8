package org.firstinspires.ftc.teamcode.Teleop;

import com.qualcomm.robotcore.eventloop.opmode.*;
import com.qualcomm.robotcore.hardware.*;
import com.qualcomm.hardware.rev.RevColorSensorV3;
import com.acmerobotics.dashboard.FtcDashboard;
import com.acmerobotics.dashboard.telemetry.MultipleTelemetry;
import com.acmerobotics.dashboard.config.Config;

import android.graphics.Color;

import org.firstinspires.ftc.robotcore.external.hardware.camera.WebcamName;
import org.firstinspires.ftc.vision.VisionPortal;
import org.firstinspires.ftc.vision.apriltag.*;

import java.util.List;

@Config
class Tunables {

    public static double RPM_PRESET_A = 3400;
    public static double RPM_PRESET_B = 4200;
    public static double HOOD_A = 0.22;
    public static double HOOD_B = 0.15;

    public static double kP = 0.0012;
    public static double kI = 0.00025;
    public static double kD = 0.00008;
    public static double BANG_BANG_RPM = 700;
    public static double MAX_POWER = 1.0;
    public static double INTEGRAL_LIMIT = 0.4;

    public static long FIRST_SHOT_DELAY = 500;
    public static long SERVO_OUT_TIME = 420;
    public static long WAIT_BETWEEN_SHOTS = 460;

    public static double[] SPINDEX_SLOTS = {0.0, 0.45, 0.93, 0.70, 0.23};
    public static int[] INTAKE_SLOTS = {0,1,2};
    public static int[] OUTTAKE_SLOTS = {3,4};
    public static long SLOT_DELAY = 350;

    public static float GREEN_H_MIN = 150f, GREEN_H_MAX = 165f;
    public static float GREEN_S_MIN = 0.6f, GREEN_V_MIN = 0.2f;
    public static float PURPLE_H_MIN = 215f, PURPLE_H_MAX = 230f;
    public static float PURPLE_S_MIN = 0.4f, PURPLE_V_MIN = 0.2f;

    public static double HEADING_KP = 0.01;
    public static double HEADING_KD = 0.002;
    public static double HEADING_DEADBAND = 1.2;
    public static double MAX_TURN = 0.5;
}

@TeleOp(name = "TeleOp REWRITE – Full System Fixed", group = "Linear")
public class TeleOpRewriteFixed extends LinearOpMode {

    DcMotor FL, FR, BL, BR;
    DcMotorEx shooterMaster, shooterSlave, intake;
    Servo transfer, hood, spindexServo;
    RevColorSensorV3 color;

    VisionPortal portal;
    AprilTagProcessor tag;

    ShooterController shooter;
    SpindexController spindex;
    ShooterFSM shooterFSM;

    double lastHeadingErr = 0;
    long lastHeadingTime = 0;

    static final double TICKS_PER_REV = 28.0;
    static final double GEAR_RATIO = 1.0;

    @Override
    public void runOpMode() {

        telemetry = new MultipleTelemetry(telemetry, FtcDashboard.getInstance().getTelemetry());

        // --- Hardware Map ---
        FL = hardwareMap.get(DcMotor.class, "CH_motor1");
        FR = hardwareMap.get(DcMotor.class, "CH_motor2");
        BL = hardwareMap.get(DcMotor.class, "CH_motor0");
        BR = hardwareMap.get(DcMotor.class, "CH_motor3");

        shooterMaster = hardwareMap.get(DcMotorEx.class, "EH_motor0");
        shooterSlave  = hardwareMap.get(DcMotorEx.class, "EH_motor1");
        intake        = hardwareMap.get(DcMotorEx.class, "EH_motor2");

        transfer = hardwareMap.get(Servo.class, "EH_servo4");
        hood     = hardwareMap.get(Servo.class, "EH_servo3");
        spindexServo = hardwareMap.get(Servo.class, "EH_servo5");

        color = hardwareMap.get(RevColorSensorV3.class, "colorsensor1");

        // --- Motor directions ---
        FL.setDirection(DcMotorSimple.Direction.REVERSE);
        BL.setDirection(DcMotorSimple.Direction.REVERSE);
        intake.setDirection(DcMotorSimple.Direction.REVERSE);
        shooterSlave.setDirection(shooterMaster.getDirection());

        for (DcMotor m : new DcMotor[]{FL,FR,BL,BR}) {
            m.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
            m.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        }

        shooterMaster.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        shooterSlave.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        shooterMaster.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.FLOAT);
        shooterSlave.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.FLOAT);

        intake.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        intake.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);

        transfer.setPosition(0);
        hood.setPosition(0);

        // --- Vision ---
        tag = new AprilTagProcessor.Builder().build();
        portal = new VisionPortal.Builder()
                .setCamera(hardwareMap.get(WebcamName.class, "Webcam"))
                .addProcessor(tag)
                .build();
        FtcDashboard.getInstance().startCameraStream(portal, 30);

        // --- Controllers ---
        shooter = new ShooterController();
        spindex = new SpindexController();
        shooterFSM = new ShooterFSM();
        spindex.reset();

        waitForStart();

        while (opModeIsActive()) {

            // --- Drive ---
            double y = -gamepad1.left_stick_y;
            double x =  gamepad1.left_stick_x;
            double r =  gamepad1.right_stick_x;

            if (shooter.isActive()) r += getHeadingCorrection();

            double fl = y + x + r;
            double fr = y - x - r;
            double bl = y - x + r;
            double br = y + x - r;

            double max = Math.max(1.0,
                    Math.max(Math.abs(fl),
                    Math.max(Math.abs(fr),
                    Math.max(Math.abs(bl), Math.abs(br)))));

            FL.setPower(fl / max);
            FR.setPower(fr / max);
            BL.setPower(bl / max);
            BR.setPower(br / max);

            // --- Intake ---
            boolean intakeOn = gamepad1.right_trigger > 0.2;
            intake.setPower(intakeOn ? 0.85 : 0);

            // --- Shooter ---
            boolean presetA  = gamepad1.left_trigger > 0.2;
            boolean presetB  = gamepad1.left_bumper;

            shooter.update(presetA, presetB);

            // --- Color Detection ---
            float[] hsv = new float[3];
            Color.RGBToHSV(color.red(), color.green(), color.blue(), hsv);

            boolean detected =
                    (hsv[0] >= Tunables.GREEN_H_MIN && hsv[0] <= Tunables.GREEN_H_MAX &&
                     hsv[1] >= Tunables.GREEN_S_MIN && hsv[2] >= Tunables.GREEN_V_MIN) ||
                    (hsv[0] >= Tunables.PURPLE_H_MIN && hsv[0] <= Tunables.PURPLE_H_MAX &&
                     hsv[1] >= Tunables.PURPLE_S_MIN && hsv[2] >= Tunables.PURPLE_V_MIN);

            // --- Ball Latching ---
            if (detected && intakeOn) spindex.ballPresent = true;

            spindex.update();
            shooterFSM.requestShoot(shooter.isActive());
            shooterFSM.update();

            // --- Telemetry ---
            telemetry.addData("Shooter RPM", "%.1f / %.1f", shooter.getRPM(), shooter.targetRPM);
            telemetry.addData("Ball Present", spindex.ballPresent);
            telemetry.addData("Spindex Slot", spindex.intakeIdx);
            telemetry.addData("Color Detected", detected);
            telemetry.update();
        }
    }

    // --- Spindex ---
    enum SpindexMode { INTAKE, OUTTAKE }

    class SpindexController {
        SpindexMode mode = SpindexMode.INTAKE;
        int intakeIdx = 0, outIdx = 0;
        long busyUntil = 0;
        boolean ballPresent = false;

        void update() {
            long now = System.currentTimeMillis();

            // Intake
            if (mode == SpindexMode.INTAKE && ballPresent && now >= busyUntil) {
                if (intakeIdx + 1 < Tunables.INTAKE_SLOTS.length) {
                    intakeIdx++;
                    spindexServo.setPosition(Tunables.SPINDEX_SLOTS[Tunables.INTAKE_SLOTS[intakeIdx]]);
                    busyUntil = now + Tunables.SLOT_DELAY;
                    ballPresent = false; // prevent multiple advances per ball
                }
            }

            // Outtake
            if (mode == SpindexMode.OUTTAKE && now >= busyUntil &&
                outIdx < Tunables.OUTTAKE_SLOTS.length) {
                spindexServo.setPosition(Tunables.SPINDEX_SLOTS[Tunables.OUTTAKE_SLOTS[outIdx]]);
                outIdx++;
                busyUntil = now + Tunables.SLOT_DELAY;
            }
        }

        void reset() {
            mode = SpindexMode.INTAKE;
            intakeIdx = outIdx = 0;
            spindexServo.setPosition(Tunables.SPINDEX_SLOTS[Tunables.INTAKE_SLOTS[0]]);
            ballPresent = false;
        }
    }

    // --- Shooter Controller ---
    class ShooterController {
        double integral = 0, lastErr = 0;
        long lastTime = System.nanoTime();
        double targetRPM = 0;
        double lastPower = 0;

        void update(boolean A, boolean B) {

            boolean active = A || B;

            if (!active) {
                targetRPM = 0;
                shooterMaster.setPower(0);
                shooterSlave.setPower(0);
                integral = 0;
                lastErr = 0;
                lastPower = 0;
                lastTime = System.nanoTime();
                return;
            }

            double newTarget = A ? Tunables.RPM_PRESET_A : Tunables.RPM_PRESET_B;
            if (targetRPM != newTarget) {
                integral = 0;
                lastErr = 0;
            }
            targetRPM = newTarget;

            hood.setPosition(A ? Tunables.HOOD_A : Tunables.HOOD_B);

            double rpm = getRPM();
            double error = targetRPM - rpm;

            long now = System.nanoTime();
            double dt = (now - lastTime) / 1e9;
            lastTime = now;
            if (dt <= 0) dt = 0.02;

            double power;
            if (error > Tunables.BANG_BANG_RPM) {
                power = 1.0;
                integral = 0;
            } else {
                integral += error * dt;
                integral = Math.max(-Tunables.INTEGRAL_LIMIT,
                        Math.min(Tunables.INTEGRAL_LIMIT, integral));
                double derivative = (error - lastErr) / dt;
                power = Tunables.kP * error + Tunables.kI * integral + Tunables.kD * derivative;
            }

            power = Math.max(0, Math.min(Tunables.MAX_POWER, power));
            lastErr = error;
            lastPower = power;

            shooterMaster.setPower(power);
            shooterSlave.setPower(power);
        }

        boolean isActive() { return targetRPM > 0; }

        double getRPM() {
            return (shooterMaster.getVelocity() * 60.0) / (TICKS_PER_REV * GEAR_RATIO);
        }
    }

    // --- Shooter FSM ---
    enum ShooterState { IDLE, FIRST_DELAY, SERVO_OUT, SERVO_IN }

    class ShooterFSM {
        ShooterState state = ShooterState.IDLE;
        long timer = 0;

        void requestShoot(boolean active) {
            if (!active && state != ShooterState.IDLE) {
                state = ShooterState.IDLE;
                transfer.setPosition(0);
                spindex.reset();
                return;
            }
            if (active && state == ShooterState.IDLE &&
                shooter.getRPM() >= shooter.targetRPM) {
                spindex.mode = SpindexMode.OUTTAKE;
                timer = System.currentTimeMillis();
                state = ShooterState.FIRST_DELAY;
            }
        }

        void update() {
            long now = System.currentTimeMillis();
            switch (state) {
                case FIRST_DELAY:
                    if (now - timer >= Tunables.FIRST_SHOT_DELAY) {
                        transfer.setPosition(0.5);
                        timer = now;
                        state = ShooterState.SERVO_OUT;
                    }
                    break;
                case SERVO_OUT:
                    if (now - timer >= Tunables.SERVO_OUT_TIME) {
                        transfer.setPosition(0);
                        timer = now;
                        state = ShooterState.SERVO_IN;
                    }
                    break;
                case SERVO_IN:
                    if (now - timer >= Tunables.WAIT_BETWEEN_SHOTS) {
                        state = (spindex.outIdx >= Tunables.OUTTAKE_SLOTS.length)
                                ? ShooterState.IDLE
                                : ShooterState.FIRST_DELAY;
                    }
                    break;
            }
        }
    }

    // --- Heading Correction ---
    double getHeadingCorrection() {
        List<AprilTagDetection> det = tag.getDetections();
        if (det.isEmpty()) {
            lastHeadingTime = 0;
            return 0;
        }

        double err = det.get(0).ftcPose.bearing;
        if (Math.abs(err) < Tunables.HEADING_DEADBAND) return 0;

        long now = System.currentTimeMillis();
        if (lastHeadingTime == 0) {
            lastHeadingTime = now;
            lastHeadingErr = err;
            return 0;
        }

        double dt = (now - lastHeadingTime) / 1000.0;
        if (dt <= 0) dt = 0.02;

        double d = (err - lastHeadingErr) / dt;
        double out = err * Tunables.HEADING_KP + d * Tunables.HEADING_KD;
        out = Math.max(-Tunables.MAX_TURN, Math.min(Tunables.MAX_TURN, out));

        lastHeadingErr = err;
        lastHeadingTime = now;
        return out;
    }
}