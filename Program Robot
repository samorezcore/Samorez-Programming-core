package org.firstinspires.ftc.teamcode.Teleop;

import com.qualcomm.robotcore.eventloop.opmode.*;
import com.qualcomm.robotcore.hardware.*;
import android.graphics.Color;

import com.acmerobotics.dashboard.FtcDashboard;
import com.acmerobotics.dashboard.telemetry.MultipleTelemetry;
import com.acmerobotics.dashboard.config.Config;

import org.firstinspires.ftc.robotcore.external.hardware.camera.WebcamName;
import org.firstinspires.ftc.vision.VisionPortal;
import org.firstinspires.ftc.vision.apriltag.AprilTagDetection;
import org.firstinspires.ftc.vision.apriltag.AprilTagProcessor;

import com.qualcomm.hardware.rev.RevColorSensorV3;

import java.util.List;


/* ============================================================ */

enum SpindexMode { INTAKE, OUTTAKE }
enum ShooterState { IDLE, WAIT_FOR_SPINDEX, SERVO_OUT, SERVO_IN }


/* ============================================================ */

@Config
class ShooterConfig {
    public static double kP = 1.2;
    public static double kI = 0.0005;
    public static double kD = 0.00008;
    public static double maxPower = 1.0;

    public static double preset1RPM = 4500;
    public static double preset2RPM = 2200;

    public static double preset1Hood = 0.2;
    public static double preset2Hood = 0.12;
}


/* ============================================================ */

@TeleOp(name = "TeleOp Shooter Presets FSM Fixed v6", group = "Linear Opmode")
public class Drive extends LinearOpMode {

    DcMotor FL, FR, BL, BR;
    DcMotorEx Shooter1, Shooter2, Intake;

    ServoImplEx Transfer, Hood, Spin;
    RevColorSensorV3 colorSensor;

    VisionPortal visionPortal;
    AprilTagProcessor aprilTag;

    static final double HEADING_KP = 0.01;
    static final double HEADING_KD = 0.002;
    static final double HEADING_DEADBAND = 1.2;
    static final double MAX_TURN_POWER = 0.5;

    double lastHeadingError = 0;
    long lastPidTime = 0;

    static final double[] SPINDEX_SLOTS = {0.01, 0.34, 0.67, 0.84, 0.51, 0.18};

    static final int[] INTAKE_SLOTS = {0, 1, 2};
    static final int[] OUTTAKE_SLOTS = {3, 4, 5};

    static final long SLOT_MOVE_DELAY = 340;

    static final double SERVO_OUT = 0.4;
    static final double SERVO_IN = 0.0;

    static final long SERVO_OUT_TIME = 160;
    static final long WAIT_BETWEEN_SHOTS = 200;

    static final double RPM_TOLERANCE = 120;
    static final double INTEGRAL_LIMIT = 2000;

    public static float GREEN_H_MIN = 150f;
    public static float GREEN_H_MAX = 165f;
    public static float GREEN_S_MIN = 0.6f;
    public static float GREEN_V_MIN = 0.2f;

    public static float PURPLE_H_MIN = 215f;
    public static float PURPLE_H_MAX = 230f;
    public static float PURPLE_S_MIN = 0.4f;
    public static float PURPLE_V_MIN = 0.2f;

    SpindexController spindex;
    ShooterFSM shooterFSM;

    boolean lastA = false;
    boolean lastBallDetected = false;

    double shooterIntegral = 0;
    double shooterLastError = 0;
    long shooterLastTime = 0;

    double currentTargetRPM = 0;


    /* ============================================================ */

    @Override
    public void runOpMode() {

        telemetry = new MultipleTelemetry(telemetry, FtcDashboard.getInstance().getTelemetry());

        FL = hardwareMap.get(DcMotor.class, "CH_motor1");
        FR = hardwareMap.get(DcMotor.class, "CH_motor2");
        BL = hardwareMap.get(DcMotor.class, "CH_motor0");
        BR = hardwareMap.get(DcMotor.class, "CH_motor3");

        Shooter1 = hardwareMap.get(DcMotorEx.class, "EH_motor0");
        Shooter2 = hardwareMap.get(DcMotorEx.class, "EH_motor1");
        Intake   = hardwareMap.get(DcMotorEx.class, "EH_motor2");

        Transfer = hardwareMap.get(ServoImplEx.class, "EH_servo4");
        Hood     = hardwareMap.get(ServoImplEx.class, "EH_servo3");
        Spin     = hardwareMap.get(ServoImplEx.class, "EH_servo5");

        colorSensor = hardwareMap.get(RevColorSensorV3.class, "colorsensor1");

        Spin.setPwmRange(new PwmControl.PwmRange(500, 2500));

        FL.setDirection(DcMotorSimple.Direction.REVERSE);
        BL.setDirection(DcMotorSimple.Direction.REVERSE);
        Intake.setDirection(DcMotorSimple.Direction.REVERSE);

        for (DcMotor m : new DcMotor[]{FL, FR, BL, BR}) {
            m.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
            m.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        }

        // DO NOT CHANGE shooter modes (per request)
        Shooter1.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        Shooter2.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);

        Transfer.setPosition(SERVO_IN);
        Hood.setPosition(0);

        spindex = new SpindexController();
        shooterFSM = new ShooterFSM();

        aprilTag = new AprilTagProcessor.Builder().build();

        visionPortal = new VisionPortal.Builder()
                .setCamera(hardwareMap.get(WebcamName.class, "Webcam"))
                .addProcessor(aprilTag)
                .build();

        FtcDashboard.getInstance().startCameraStream(visionPortal, 30);

        waitForStart();

        lastPidTime = System.currentTimeMillis();
        shooterLastTime = System.nanoTime();


        while (opModeIsActive()) {

            /* ================= DRIVE ================= */

            double drive  = -gamepad1.left_stick_y;
            double strafe =  gamepad1.left_stick_x;
            double rotate =  gamepad1.right_stick_x;

            if (gamepad1.right_bumper)
                rotate += getAutoHeadingPID();

            double fl = drive + strafe + rotate;
            double fr = drive - strafe - rotate;
            double bl = drive - strafe + rotate;
            double br = drive + strafe - rotate;

            double max = Math.max(1, Math.max(Math.abs(fl),
                    Math.max(Math.abs(fr), Math.max(Math.abs(bl), Math.abs(br)))));

            FL.setPower(fl / max);
            FR.setPower(fr / max);
            BL.setPower(bl / max);
            BR.setPower(br / max);


            /* ================= INPUTS ================= */

            boolean intakeOn = gamepad1.right_trigger > 0.2;
            boolean preset1  = gamepad1.left_trigger > 0.2;
            boolean preset2  = gamepad1.left_bumper;

            boolean shooterActive = preset1 || preset2;

            if (gamepad1.a && !lastA)
                spindex.resetToIntake(true);
            lastA = gamepad1.a;

            if (shooterActive) Intake.setPower(0);
            else Intake.setPower(intakeOn ? 0.85 : 0);


            /* ================= COLOR ================= */

            float[] hsv = new float[3];
            Color.RGBToHSV(colorSensor.red(), colorSensor.green(), colorSensor.blue(), hsv);

            float H = hsv[0], S = hsv[1], V = hsv[2];

            boolean detectedBall =
                    (H >= GREEN_H_MIN && H <= GREEN_H_MAX && S >= GREEN_S_MIN && V >= GREEN_V_MIN)
                            || (H >= PURPLE_H_MIN && H <= PURPLE_H_MAX && S >= PURPLE_S_MIN && V >= PURPLE_V_MIN);

            boolean ballEdge = detectedBall && !lastBallDetected;
            lastBallDetected = detectedBall;

            if (intakeOn && spindex.mode == SpindexMode.INTAKE && ballEdge)
                spindex.nextIntakeSlot();


            /* ================= PRESETS ================= */

            currentTargetRPM = 0;
            double hoodTarget = 0;

            if (preset1) {
                currentTargetRPM = ShooterConfig.preset1RPM;
                hoodTarget = ShooterConfig.preset1Hood;
            } else if (preset2) {
                currentTargetRPM = ShooterConfig.preset2RPM;
                hoodTarget = ShooterConfig.preset2Hood;
            }


            /* ================= SHOOTER PID ================= */

            double currentRPM = Shooter1.getVelocity() * 60 / 28.0;

            if (currentTargetRPM > 0) {

                long now = System.nanoTime();
                double dt = (now - shooterLastTime) / 1e9;
                if (dt <= 0) dt = 0.001; // FIX

                shooterLastTime = now;

                double error = currentTargetRPM - currentRPM;

                shooterIntegral += error * dt;
                shooterIntegral = Math.max(-INTEGRAL_LIMIT, Math.min(INTEGRAL_LIMIT, shooterIntegral));

                double derivative = (error - shooterLastError) / dt;
                shooterLastError = error;

                double pid = ShooterConfig.kP * error
                        + ShooterConfig.kI * shooterIntegral
                        + ShooterConfig.kD * derivative;

                double power = Math.max(-ShooterConfig.maxPower,
                        Math.min(ShooterConfig.maxPower, pid));

                Shooter1.setPower(power);
                Shooter2.setPower(power);

                Hood.setPosition(hoodTarget);

            } else {

                Shooter1.setPower(0);
                Shooter2.setPower(0);
                shooterIntegral = 0;
                shooterLastError = 0;
                Hood.setPosition(0);
            }


            shooterFSM.requestShoot(shooterActive);
            spindex.update();
            shooterFSM.update();


            telemetry.addData("RPM", currentRPM);
            telemetry.addData("Target", currentTargetRPM);
            telemetry.addData("Spindex", spindex.intakeIndex);
            telemetry.update();
        }

        if (visionPortal != null)
            visionPortal.close();
    }


    /* ============================================================ */

    class SpindexController {

        SpindexMode mode = SpindexMode.INTAKE;

        int intakeIndex = 0;
        int outtakeIndex = 0;

        boolean busy = false;
        long busyUntil = 0;

        void nextIntakeSlot() {
            long now = System.currentTimeMillis();
            if (busy && now < busyUntil) return;

            if (intakeIndex < INTAKE_SLOTS.length - 1) {
                intakeIndex++;
                moveToSlot(INTAKE_SLOTS[intakeIndex]);
                busyUntil = now + SLOT_MOVE_DELAY;
                busy = true;
            }
        }

        void nextOuttakeSlot() {
            long now = System.currentTimeMillis();
            if (busy && now < busyUntil) return;

            if (outtakeIndex < OUTTAKE_SLOTS.length - 1) { // FIX
                outtakeIndex++;
                moveToSlot(OUTTAKE_SLOTS[outtakeIndex]);
                busyUntil = now + SLOT_MOVE_DELAY;
                busy = true;
            }
        }

        void moveToSlot(int slot) {
            Spin.setPosition(SPINDEX_SLOTS[slot]);
        }

        void update() {
            busy = System.currentTimeMillis() < busyUntil;
        }

        void resetToIntake(boolean moveServo) {
            mode = SpindexMode.INTAKE;
            intakeIndex = 0;
            outtakeIndex = 0;
            if (moveServo) moveToSlot(INTAKE_SLOTS[0]);
        }

        boolean outtakeDone() {
            return outtakeIndex >= OUTTAKE_SLOTS.length - 1;
        }
    }


    /* ============================================================ */

    class ShooterFSM {

        ShooterState state = ShooterState.IDLE;

        long timer = 0;

        boolean lastHeld = false;

        void requestShoot(boolean held) {

            boolean pressed = held && !lastHeld;
            lastHeld = held;

            if (!held) {
                state = ShooterState.IDLE;
                Transfer.setPosition(SERVO_IN);
                spindex.mode = SpindexMode.INTAKE;
                return;
            }

            if (pressed && state == ShooterState.IDLE) {

                spindex.mode = SpindexMode.OUTTAKE;
                spindex.outtakeIndex = 0;
                spindex.moveToSlot(OUTTAKE_SLOTS[0]);

                state = ShooterState.WAIT_FOR_SPINDEX;
            }
        }

        void update() {

            long now = System.currentTimeMillis();
            double rpm = Shooter1.getVelocity() * 60 / 28.0;

            switch (state) {

                case WAIT_FOR_SPINDEX:
                    if (!spindex.busy && Math.abs(rpm - currentTargetRPM) < RPM_TOLERANCE) {
                        Transfer.setPosition(SERVO_OUT);
                        timer = now;
                        state = ShooterState.SERVO_OUT;
                    }
                    break;

                case SERVO_OUT:
                    if (now - timer >= SERVO_OUT_TIME) {
                        Transfer.setPosition(SERVO_IN);
                        timer = now;
                        state = ShooterState.SERVO_IN;
                    }
                    break;

                case SERVO_IN:
                    if (now - timer >= WAIT_BETWEEN_SHOTS) {
                        if (spindex.outtakeDone()) state = ShooterState.IDLE;
                        else {
                            spindex.nextOuttakeSlot();
                            state = ShooterState.WAIT_FOR_SPINDEX;
                        }
                    }
                    break;

                case IDLE:
                default:
                    break;
            }
        }
    }


    /* ============================================================ */

    private double getAutoHeadingPID() {

        List<AprilTagDetection> detections = aprilTag.getDetections();
        if (detections.isEmpty()) return 0;

        double error = detections.get(0).ftcPose.bearing;

        long now = System.currentTimeMillis();
        double dt = (now - lastPidTime) / 1000.0;
        if (dt <= 0) dt = 0.001;

        double derivative = (error - lastHeadingError) / dt;

        double output = error * HEADING_KP + derivative * HEADING_KD;

        output = Math.max(-MAX_TURN_POWER, Math.min(MAX_TURN_POWER, output));

        lastHeadingError = error;
        lastPidTime = now;

        return output;
    }
}