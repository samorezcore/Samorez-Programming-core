package org.firstinspires.ftc.teamcode.Teleop;

import com.qualcomm.robotcore.eventloop.opmode.*;
import com.qualcomm.robotcore.hardware.*;
import android.graphics.Color;

import com.acmerobotics.dashboard.FtcDashboard;
import com.acmerobotics.dashboard.telemetry.MultipleTelemetry;
import com.acmerobotics.dashboard.config.Config;

import com.qualcomm.hardware.rev.RevColorSensorV3;

enum SpindexMode { INTAKE, OUTTAKE }

@Config
class ShooterConfig {
    // Shooter RPM presets
    public static double RPM_PRESET_A = 3400; // trigger
    public static double RPM_PRESET_B = 4200; // left bumper

    // Hood positions
    public static double HOOD_PRESET_A = 0.22;
    public static double HOOD_PRESET_B = 0.15;

    // Shooter control
    public static double bangBangRPM = 700;
    public static double kP = 0.0012;
    public static double kI = 0.00025;
    public static double kD = 0.00008;
    public static double maxPower = 1.0;

    // Servo timings
    public static long PRE_SHOT_DELAY = 500;
    public static long SERVO_OUT_TIME = 420;
    public static long WAIT_BETWEEN_SHOTS = 460;
}

@TeleOp(name = "TeleOp Full Shooter + Intake", group = "Linear OpMode")
public class FullTeleOp extends LinearOpMode {

    // Drive motors
    DcMotor FL, FR, BL, BR;

    // Shooter & intake
    DcMotorEx Shooter1, Shooter2, Intake;

    // Servos
    Servo Transfer, Hood, Spin;

    // Color sensor
    RevColorSensorV3 colorSensor;

    // Spindex & Shooter FSM
    SpindexController spindex;
    ShooterFSM shooterFSM;

    boolean lastA = false;
    boolean lastDetectedBall = false;

    // Shooter PID
    double shooterIntegral = 0;
    double shooterLastError = 0;
    long shooterLastTime = 0;

    static final double TICKS_PER_REV = 28.0;
    static final double GEAR_RATIO = 1.0;

    @Override
    public void runOpMode() {

        telemetry = new MultipleTelemetry(telemetry, FtcDashboard.getInstance().getTelemetry());

        // === Hardware Map ===
        FL = hardwareMap.get(DcMotor.class, "CH_motor1");
        FR = hardwareMap.get(DcMotor.class, "CH_motor2");
        BL = hardwareMap.get(DcMotor.class, "CH_motor0");
        BR = hardwareMap.get(DcMotor.class, "CH_motor3");

        Shooter1 = hardwareMap.get(DcMotorEx.class, "EH_motor0");
        Shooter2 = hardwareMap.get(DcMotorEx.class, "EH_motor1");
        Intake   = hardwareMap.get(DcMotorEx.class, "EH_motor2");

        Transfer = hardwareMap.get(Servo.class, "EH_servo4");
        Hood     = hardwareMap.get(Servo.class, "EH_servo3");
        Spin     = hardwareMap.get(Servo.class, "EH_servo5");

        colorSensor = hardwareMap.get(RevColorSensorV3.class, "colorsensor1");

        // Directions
        FL.setDirection(DcMotorSimple.Direction.REVERSE);
        BL.setDirection(DcMotorSimple.Direction.REVERSE);
        Intake.setDirection(DcMotorSimple.Direction.REVERSE);

        for (DcMotor m : new DcMotor[]{FL, FR, BL, BR}) {
            m.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
            m.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        }

        Shooter1.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        Shooter2.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        Shooter1.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.FLOAT);
        Shooter2.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.FLOAT);

        Intake.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        Intake.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);

        Transfer.setPosition(0);
        Hood.setPosition(0);
        Spin.setPosition(0);

        // Spindex + FSM
        spindex = new SpindexController();
        spindex.resetToIntake();
        shooterFSM = new ShooterFSM();

        waitForStart();
        shooterLastTime = System.nanoTime();

        while (opModeIsActive()) {

            // ===== DRIVE =====
            double drive = -gamepad1.left_stick_y;
            double strafe = gamepad1.left_stick_x;
            double rotate = gamepad1.right_stick_x;

            double fl = drive + strafe + rotate;
            double fr = drive - strafe - rotate;
            double bl = drive - strafe + rotate;
            double br = drive + strafe - rotate;

            double max = Math.max(1.0, Math.max(Math.abs(fl),
                    Math.max(Math.abs(fr), Math.max(Math.abs(bl), Math.abs(br)))));
            FL.setPower(fl / max);
            FR.setPower(fr / max);
            BL.setPower(bl / max);
            BR.setPower(br / max);

            // ===== INPUTS =====
            boolean intakeOn = gamepad1.right_trigger > 0.2;
            boolean shooterA = gamepad1.left_trigger > 0.2;
            boolean shooterB = gamepad1.left_bumper;
            boolean shooterActive = shooterA || shooterB;

            double targetRPM = shooterA ? ShooterConfig.RPM_PRESET_A :
                    shooterB ? ShooterConfig.RPM_PRESET_B : 0;
            double hoodPos = shooterA ? ShooterConfig.HOOD_PRESET_A :
                    shooterB ? ShooterConfig.HOOD_PRESET_B : 0.0;

            Hood.setPosition(shooterActive ? hoodPos : 0.0);

            if(gamepad1.a && !lastA) spindex.resetToIntake();
            lastA = gamepad1.a;

            Intake.setPower(intakeOn ? 0.85 : 0);

            // ===== SHOOTER CONTROL =====
            double shooterRPM = (Shooter1.getVelocity() * 60.0)/(TICKS_PER_REV*GEAR_RATIO);
            double power = 0;

            if(shooterActive) {
                long now = System.nanoTime();
                double dt = (now - shooterLastTime)/1e9;
                shooterLastTime = now;
                if(dt <=0) dt = 0.02;

                double error = targetRPM - shooterRPM;

                // Bang-bang + PID
                if(error > ShooterConfig.bangBangRPM) {
                    power = 1.0;
                    shooterIntegral = 0;
                } else {
                    shooterIntegral += error * dt;
                    double derivative = (error - shooterLastError)/dt;
                    power = ShooterConfig.kP*error + ShooterConfig.kI*shooterIntegral + ShooterConfig.kD*derivative;
                    power = Math.max(0, Math.min(ShooterConfig.maxPower, power));
                    shooterLastError = error;
                }

                Shooter1.setPower(power);
                Shooter2.setPower(power);
            } else {
                Shooter1.setPower(0);
                Shooter2.setPower(0);
                shooterIntegral = 0;
                shooterLastError = 0;
            }

            // ===== COLOR DETECTION =====
            float[] hsv = new float[3];
            Color.RGBToHSV(colorSensor.red(), colorSensor.green(), colorSensor.blue(), hsv);
            boolean detectedBall = (hsv[0] > 140 && hsv[1] > 0.4 && hsv[2] > 0.2);

            if(intakeOn && detectedBall && !lastDetectedBall) {
                spindex.nextIntakeSlot();
            }
            lastDetectedBall = detectedBall;

            spindex.update();
            shooterFSM.requestShoot(shooterActive);
            shooterFSM.update();

            // ===== TELEMETRY =====
            telemetry.addData("Shooter RPM", shooterRPM);
            telemetry.addData("Shooter Power", power);
            telemetry.addData("Hood Pos", Hood.getPosition());
            telemetry.addData("Intake Slot", spindex.currentSlot());
            telemetry.addData("Spindex Mode", spindex.mode);
            telemetry.addData("Ball Detected", detectedBall);
            telemetry.update();
        }
    }

    // ===== SPINDEX CONTROLLER =====
    class SpindexController {
        SpindexMode mode = SpindexMode.INTAKE;
        int index = 0;
        long busyUntil = 0;
        static final double[] SLOTS = {0.0, 0.45, 0.93, 0.7, 0.23};
        static final int[] INTAKE_SLOTS = {0,1,2};
        static final int[] OUTTAKE_SLOTS = {3,4};
        static final long SLOT_DELAY = 200;

        void nextIntakeSlot() {
            index++;
            if(index >= INTAKE_SLOTS.length) index = INTAKE_SLOTS.length-1;
            Spin.setPosition(SLOTS[INTAKE_SLOTS[index]]);
            busyUntil = System.currentTimeMillis() + SLOT_DELAY;
        }

        void nextOuttakeSlot() {
            index++;
            if(index >= OUTTAKE_SLOTS.length) index = OUTTAKE_SLOTS.length-1;
            Spin.setPosition(SLOTS[OUTTAKE_SLOTS[index]]);
            busyUntil = System.currentTimeMillis() + SLOT_DELAY;
        }

        void update() {
            // no additional logic
        }

        void resetToIntake() {
            mode = SpindexMode.INTAKE;
            index = 0;
            Spin.setPosition(SLOTS[INTAKE_SLOTS[0]]);
            busyUntil = 0;
        }

        int currentSlot() {
            return index;
        }
    }

    // ===== SHOOTER FSM =====
    class ShooterFSM {
        enum State {IDLE, ARM_SLOT, PRE_SHOT, SERVO_OUT, SERVO_IN_WAIT, MOVE_TO_SLOT, WAIT_SPINDEX}
        State state = State.IDLE;
        long timer = 0;

        void requestShoot(boolean shooterActive) {
            if(!shooterActive) {
                state = State.IDLE;
                Transfer.setPosition(0);
                spindex.resetToIntake();
                return;
            }

            if(state == State.IDLE) {
                spindex.mode = SpindexMode.OUTTAKE;
                spindex.index = 0;
                spindex.Spin.setPosition(SpindexController.SLOTS[SpindexController.OUTTAKE_SLOTS[0]]);
                timer = System.currentTimeMillis();
                state = State.ARM_SLOT;
            }
        }

        void update() {
            long now = System.currentTimeMillis();
            switch(state) {
                case ARM_SLOT:
                    if(now - timer >= ShooterConfig.PRE_SHOT_DELAY) {
                        Transfer.setPosition(0.5);
                        timer = now;
                        state = State.SERVO_OUT;
                    }
                    break;
                case SERVO_OUT:
                    if(now - timer >= ShooterConfig.SERVO_OUT_TIME) {
                        Transfer.setPosition(0);
                        timer = now;
                        state = State.SERVO_IN_WAIT;
                    }
                    break;
                case SERVO_IN_WAIT:
                    if(now - timer >= ShooterConfig.WAIT_BETWEEN_SHOTS) state = State.MOVE_TO_SLOT;
                    break;
                case MOVE_TO_SLOT:
                    spindex.nextOuttakeSlot();
                    timer = now;
                    state = State.WAIT_SPINDEX;
                    break;
                case WAIT_SPINDEX:
                    if(now - timer >= ShooterConfig.SLOT_MOVE_DELAY) state = State.IDLE;
                    break;
                case IDLE: break;
            }
        }
    }
}